# Demo runs without AWS. Deploy the persistence backend before switching to live.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=
# Optional Amazon Location MapLibre style URL, using a restricted public map key.
VITE_MAP_STYLE_URL=
# Live: set both API URLs to the WorkspaceApiUrl SAM output, with no trailing slash.
# Keep the existing Region and Cognito client when updating the same stack.
# These are public configuration values, never AWS credentials or secret keys.
VITE_AI_API_URL=
VITE_AWS_REGION=
VITE_COGNITO_CLIENT_ID=
