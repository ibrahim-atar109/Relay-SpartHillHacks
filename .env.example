# Demo runs without AWS. Switching to live requires the documented API.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=http://localhost:3001
# Optional Amazon Location MapLibre style URL, using a restricted public map key.
VITE_MAP_STYLE_URL=
# Optional Bedrock features, independent of VITE_DATA_MODE (keep demo for scenario workflow).
# These are public configuration values, never AWS credentials or secret keys.
VITE_AI_API_URL=
VITE_AWS_REGION=
VITE_COGNITO_CLIENT_ID=
