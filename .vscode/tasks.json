{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Relay: start dev server",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(.*):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:.*http://127.0.0.1:5173/"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
